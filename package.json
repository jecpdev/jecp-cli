{
  "name": "@jecpdev/cli",
  "version": "0.6.1",
  "description": "Command-line interface for JECP — register agents, invoke capabilities, manage Providers from your terminal.",
  "type": "module",
  "bin": {
    "jecp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "jecp",
    "cli",
    "agent-commerce-protocol",
    "ai-agent",
    "developer-tool"
  ],
  "author": "Tufe Company Inc. <hello@jecp.dev>",
  "license": "Apache-2.0",
  "homepage": "https://jecp.dev",
  "bugs": {
    "url": "https://github.com/jecpdev/jecp-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jecpdev/jecp-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jecpdev/sdk": "^0.5.0",
    "commander": "^13.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
